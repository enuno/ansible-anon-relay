# Environment Variables for Cursor IDE and AI Agents
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ===========================================
# AI Provider API Keys
# ===========================================

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API Key (Optional)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Cursor AI Configuration
CURSOR_AI_MODEL=claude-3.5-sonnet
CURSOR_AI_ENABLED=true

# ===========================================
# Ansible Configuration
# ===========================================

# Ansible Vault Password
# Store your vault password here or use vault-password-file
#ANSIBLE_VAULT_PASSWORD=your-vault-password-here

# Ansible Configuration File Path
ANSIBLE_CONFIG=./ansible.cfg

# Ansible Inventory Path
ANSIBLE_INVENTORY=./inventory.ini

# Ansible Remote User
ANSIBLE_REMOTE_USER=ubuntu

# Ansible Become Method
ANSIBLE_BECOME_METHOD=sudo

# ===========================================
# Project-Specific Settings
# ===========================================

# Project Name
PROJECT_NAME=anon-relay-ansible-deployment

# Project Version
PROJECT_VERSION=2.0.0

# Default Relay Type (standard, exit, socks)
DEFAULT_RELAY_TYPE=standard

# ===========================================
# Anyone Protocol Configuration
# ===========================================

# Docker Image for Anon Relay
ANON_DOCKER_IMAGE=svforte/anon:latest

# Default Relay Nickname Prefix
ANON_RELAY_NICKNAME_PREFIX=Anon

# Default Contact Email (DO NOT use real email here)
ANON_DEFAULT_CONTACT=operator@example.com

# ===========================================
# Development Settings
# ===========================================

# Python Virtual Environment Path
VENV_PATH=./.venv

# Enable Debug Mode (true/false)
DEBUG_MODE=false

# Verbose Logging Level (0-3)
VERBOSE_LEVEL=0

# ===========================================
# Security Settings
# ===========================================

# SSH Key Path for Ansible
ANSIBLE_SSH_KEY_PATH=~/.ssh/id_rsa

# Ansible Vault Password File Path
#ANSIBLE_VAULT_PASSWORD_FILE=~/.ansible_vault_pass

# ===========================================
# Testing Settings
# ===========================================

# Test Environment
TEST_ENV=development

# Molecule Driver (docker, vagrant, ec2)
MOLECULE_DRIVER=docker

# ===========================================
# CI/CD Settings
# ===========================================

# GitHub Actions Enabled
GITHUB_ACTIONS_ENABLED=true

# Linting Enabled
LINTING_ENABLED=true

# ===========================================
# Monitoring & Logging
# ===========================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log Output Directory
LOG_DIR=./logs

# ===========================================
# Network Configuration
# ===========================================

# Default OR Port for Standard Relay
DEFAULT_OR_PORT=9001

# Default DIR Port for Exit Relay
DEFAULT_DIR_PORT=80

# Default SOCKS Port for SOCKS Proxy
DEFAULT_SOCKS_PORT=9050

# ===========================================
# Docker Configuration
# ===========================================

# Docker Edition (ce = Community Edition)
DOCKER_EDITION=ce

# Docker Compose Version
DOCKER_COMPOSE_VERSION=latest

# ===========================================
# NOTES
# ===========================================

# 1. This file should be copied to .env and customized
# 2. Never commit .env to version control (already in .gitignore)
# 3. Use Ansible Vault for sensitive production values
# 4. API keys shown here are examples - use your real keys
# 5. For exit relays, review legal requirements before deployment
