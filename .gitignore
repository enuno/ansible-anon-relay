# .gitignore for Ansible Playbook Project

# Ansible specific
*.retry
.ansible/
*.vault_pass
.vault_pass
.vault_password
vault_pass.txt
group_vars/*/vault.yml.decrypted
host_vars/*/vault.yml.decrypted

# Molecule
.molecule/
molecule/**/pytest_cache/
molecule/**/__pycache__/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/
.venv/
.ENV/
.env/

# Testing
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.hypothesis/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# OS specific
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*

# Backup files
*.bak
*.backup
*.old
*.orig
*.tmp

# Logs
logs/
*.log
*.out

# Secrets and credentials (NEVER COMMIT)
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
secrets/
credentials/
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Documentation builds
docs/_build/
docs/.doctrees/
site/

# CI/CD
.gitlab-ci-local/

# Terraform (if used alongside)
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Vagrant
.vagrant/
*.box

# Docker
.docker/

# Local development
local/
local-*

# Ansible Galaxy downloaded roles/collections (if not tracking)
# Uncomment if you don't want to track Galaxy installs
# roles/external/
# collections/

# Ansible vault temporary files
*.vault.tmp

# Pre-commit
.pre-commit-config.yaml.lock

# Misc
.idea_modules/
atlassian-ide-plugin.xml
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties
