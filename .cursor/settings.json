{
  // Editor Settings
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [120, 160],
  "editor.wordWrap": "on",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // Files
  "files.associations": {
    "*.yml": "ansible",
    "*.yaml": "ansible",
    "*.j2": "jinja",
    "anonrc": "ini",
    ".clinerules": "markdown",
    "Dockerfile*": "dockerfile"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.retry": true,
    "**/.molecule": true,
    "**/.pytest_cache": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Ansible Extension
  "ansible.validation.lint.enabled": true,
  "ansible.validation.lint.path": "ansible-lint",
  "ansible.validation.lint.arguments": "--profile=production",
  "ansible.ansible.path": "ansible",
  "ansible.python.interpreterPath": "${workspaceFolder}/.venv/bin/python",

  // YAML Extension
  "yaml.schemas": {
    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json": [
      "*.yml",
      "*.yaml"
    ]
  },
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.format.proseWrap": "preserve",
  "yaml.validate": true,
  "yaml.hover": true,
  "yaml.completion": true,

  // Python
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black",

  // Cursor AI Settings
  "cursor.ai.enabled": true,
  "cursor.ai.model": "claude-3.5-sonnet",
  "cursor.ai.contextFiles": [
    "AGENTS.md",
    "CLAUDE.md",
    "DEVELOPMENT_PLAN.md",
    "README.md"
  ],
  "cursor.ai.autoComplete": true,
  "cursor.ai.chatHistory": true,

  // GitHub Copilot
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "ansible": true,
    "jinja": true,
    "markdown": true
  },
  "github.copilot.advanced": {
    "debug.overrideEngine": "claude-3.5-sonnet"
  },

  // Terminal
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.linux": {
    "ANSIBLE_CONFIG": "${workspaceFolder}/ansible.cfg"
  },
  "terminal.integrated.env.osx": {
    "ANSIBLE_CONFIG": "${workspaceFolder}/ansible.cfg"
  },

  // Search
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.molecule": true,
    "**/__pycache__": true,
    "**/*.retry": true
  },

  // Formatting
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "advanced"
  },
  "[ansible]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jinja]": {
    "editor.defaultFormatter": "samuelcolvin.jinjahtml",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.wordWrap": "on"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4
  },

  // Spell Checker
  "cSpell.words": [
    "anon",
    "anonrc",
    "ansible",
    "playbook",
    "docker",
    "dockerd",
    "containerd",
    "buildx",
    "svforte",
    "ator",
    "depin",
    "orport",
    "dirport",
    "socksport",
    "myfamily",
    "exitrelay",
    "cgnat",
    "ufw",
    "fail2ban",
    "yamllint",
    "jinja2"
  ],

  // Project-Specific Settings
  "ansible.python.activationScript": "${workspaceFolder}/.venv/bin/activate",
  
  // Tasks
  "task.autoDetect": "on",
  
  // Git
  "git.ignoreLimitWarning": true,
  "git.enabled": true,

  // Security
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "prompt",

  // Bracket Pair Colorization
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  // Minimap
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 160,

  // Breadcrumbs
  "breadcrumbs.enabled": true,

  // Problems
  "problems.decorations.enabled": true,

  // Outline
  "outline.showVariables": true,
  "outline.showFunctions": true
}
