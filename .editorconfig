# EditorConfig for Ansible Playbook Project
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files (Ansible playbooks, roles, vars)
[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 160

# Jinja2 templates
[*.j2]
indent_style = space
indent_size = 2
max_line_length = 160

# Python files (for modules, plugins, filters)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown documentation
[*.md]
indent_style = space
indent_size = 2
max_line_length = 120
trim_trailing_whitespace = false

# Makefile (uses tabs)
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# INI files (inventory)
[*.ini]
indent_style = space
indent_size = 2

# Configuration files
[*.{conf,cfg}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# TOML files (pyproject.toml)
[*.toml]
indent_style = space
indent_size = 4

# GitHub Actions workflows
[.github/workflows/*.{yml,yaml}]
indent_style = space
indent_size = 2

# Ansible configuration
[ansible.cfg]
indent_style = space
indent_size = 2

# Git files
[.gitignore]
indent_style = space
indent_size = 2

# Docker files
[{Dockerfile,*.dockerfile}]
indent_style = space
indent_size = 2

[.dockerignore]
indent_style = space
indent_size = 2
